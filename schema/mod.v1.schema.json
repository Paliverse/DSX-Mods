{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Paliverse/DSX-Mods/blob/main/schema/mod.v1.schema.json",
  "title": "DSX-Mods mod.json (v1)",
  "description": "One mod in mods/<id>/mod.json. tools/catalog.py validate applies these rules plus the site allowlist and catalog-wide checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "author",
    "games",
    "summary",
    "description",
    "links",
    "features",
    "transports",
    "status"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^\\S(.*\\S)?$",
      "description": "The mod's name."
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[^@\\s](.*\\S)?$",
          "description": "The author's name without @ (DSX shows @name)."
        },
        "url": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^https://[^\\s@/:]+(/[^\\s]*)?$",
          "description": "https only; the host must be on tools/allowed-hosts.txt (checked by tools/catalog.py)"
        }
      }
    },
    "maintainers": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
      },
      "description": "GitHub accounts that may change this entry."
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(.*\\S)?$",
            "description": "The game's name as stores show it; DSX matches installed games by it (case, \u2122, \u00ae and colons ignored)."
          },
          "steam_app_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 2147483647
          },
          "aliases": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^\\S(.*\\S)?$",
              "description": "Another name the game is listed under."
            }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^\\S(.*\\S)?$",
      "description": "One line on what the mod does."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Plain text; line breaks allowed; no HTML or Markdown."
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^\\S(.*\\S)?$",
      "description": "One requirement or limit, when there is one."
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "home"
      ],
      "properties": {
        "home": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^https://[^\\s@/:]+(/[^\\s]*)?$",
          "description": "https only; the host must be on tools/allowed-hosts.txt (checked by tools/catalog.py)"
        },
        "source": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^https://[^\\s@/:]+(/[^\\s]*)?$",
          "description": "https only; the host must be on tools/allowed-hosts.txt (checked by tools/catalog.py)"
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "triggers",
          "lights",
          "rumble",
          "haptics",
          "audio",
          "remap"
        ]
      }
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "udp",
          "pipe"
        ]
      }
    },
    "mod_ids": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,64}$"
      },
      "description": "The ModId values the mod sends to DSX; unique across the catalog."
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dsx": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+){0,3}$"
        }
      }
    },
    "status": {
      "enum": [
        "listed",
        "deprecated"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(.*\\S)?$",
      "description": "Why a deprecated mod is deprecated."
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "deprecated"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "reason"
    ]
  },
  "else": {
    "not": {
      "required": [
        "reason"
      ]
    }
  }
}
